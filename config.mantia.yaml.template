# Local Mantia/Moodle configuration template.
# Copy this file to the ignored config.yaml, then provide credentials locally.
# Never commit the generated config.yaml.

schema_version: 1
sites:
  - id: mantia1
    provider: MANTIA
    login_url: https://betaformacion.mantia.es/login/index.php
    username: "${MANTIA_USERNAME}"
    password: "${MANTIA_PASSWORD}"
    start_date: "2026-11-6"
    end_date: "2026-11-18"
    start_time: "14:30"
    end_time: "16:30"
    timezone: Europe/Madrid
    interval_seconds: 300
    timeout_seconds: 30
    max_retries: 2
    log_file: data/local/logs/mantia1.log
    navigation:
      version: "1.0"
      allowed_origin: https://betaformacion.mantia.es/
      steps:
        - order: 1
          method: GET
          read_only: true
          url: https://betaformacion.mantia.es/my/
          expected_result:
            status_code: 200
            url_path: /my/
        - order: 2
          method: GET
          read_only: true
          url: https://betaformacion.mantia.es/course/view.php?id=56
          expected_result:
            status_code: 200
            url_path: /course/view.php
        - order: 3
          method: GET
          read_only: true
          url: https://betaformacion.mantia.es/mod/forum/view.php?id=3834
          expected_result:
            status_code: 200
            url_path: /mod/forum/view.php
        - order: 4
          method: GET
          read_only: true
          url: https://betaformacion.mantia.es/mod/scorm/view.php?id=3838
          expected_result:
            status_code: 200
            url_path: /mod/scorm/view.php
