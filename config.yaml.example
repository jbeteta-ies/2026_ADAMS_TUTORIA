# Plantilla de monitorización de sitios web (schema_version: 1).
# Copiar a config.yaml y adaptar los valores. Nunca versionar contraseñas reales.
# Cada elemento de sites se monitoriza independientemente.
# IMPORTANTE: el proveedor debe disponer de un adaptador de login implementado;
# la configuración de otro proveedor (p. ej., Mantia) no basta por sí sola.
# Los valores de example.invalid son ficticios y no deben utilizarse en producción.

schema_version: 1  # Obligatorio; única versión admitida actualmente: 1.

sites:
  - id: demo-site  # Obligatorio; identificador único entre los sitios.
    provider: ADAMS  # Obligatorio; nombre de un proveedor con adaptador de login.
    login_url: https://example.invalid/login  # Obligatorio; URL HTTP(S) de login.
    username: change-me  # Obligatorio; usuario no vacío, configurado solo localmente.
    password: change-me  # Obligatorio; contraseña no vacía, configurada solo localmente.

    # Ventana de ejecución. Todos estos campos son opcionales.
    # Fechas inclusive (YYYY-MM-DD); sin fechas, no se acota el periodo.
    start_date: "2026-01-01"
    end_date: "2026-12-31"
    # Días admitidos: MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY,
    # SATURDAY, SUNDAY. Por defecto: todos los días.
    weekdays: [MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY]
    # Horas locales HH:MM o HH:MM:SS; por defecto 00:00:00–23:59:59.
    # start_time y end_time deben ser diferentes.
    start_time: "08:00"
    end_time: "20:00"
    timezone: Europe/Madrid  # Zona IANA; por defecto UTC.

    # Opcionales, con sus valores por defecto a continuación.
    interval_seconds: 300  # Segundos entre comprobaciones; entero >= 1.
    timeout_seconds: 30  # Timeout de login/sitio; entero >= 1.
    max_retries: 2  # Reintentos adicionales de login; entero entre 0 y 5.
    log_file: data/local/logs/demo-site.log  # Ruta relativa segura; por defecto data/local/logs/<id>.log.

    # Elegir EXACTAMENTE UNA alternativa:
    # A) target_url: una sola URL objetivo tras el login, sin pasos declarativos.
    # B) navigation: secuencia de pasos GET/POST, como este ejemplo.
    # No activar target_url y navigation a la vez.
    # target_url: https://example.invalid/home
    navigation:
      version: "1.0"  # Obligatorio dentro de navigation.
      allowed_origin: https://example.invalid/  # Obligatorio; mismo origen para todos los pasos.
      steps:  # Obligatorio; de 1 a 20 pasos con order consecutivo desde 1.
        - order: 1
          method: GET  # GET o POST; obligatorio.
          url: https://example.invalid/courses  # Obligatoria; mismo origen que allowed_origin.
          params: {view: "summary"}  # Opcional; query string, claves y valores de texto.
          # form_data: {}  # Opcional; por defecto vacío; solo se envía en POST.
          timeout_seconds: 30  # Opcional por paso; de 1 a 120 segundos (defecto: 30).
          expected_result:  # Obligatorio; al menos una señal de éxito.
            status_code: 200  # Opcional; estado HTTP esperado (100–599).
            url_path: /courses  # Opcional; ruta absoluta de la respuesta, sin query.
            # text_marker: "Cursos"  # Opcional; cadena que debe aparecer en el contenido.

        - order: 2
          method: POST
          read_only: true  # Obligatorio en POST: autorización explícita; NO evita cambios en el servidor.
          url: https://example.invalid/select-course
          form_data: {course: "sample-course"}  # Obligatorio y no vacío para POST; valores de texto.
          # params: {source: "monitor"}  # Opcional: query string adicional.
          # csrf_field: csrf_token  # Opcional: nombre de input oculto de la página actual;
          #                         # su valor se lee en memoria, nunca se escribe en YAML.
          expected_result:
            status_code: 200

        - order: 3
          method: GET
          url: https://example.invalid/course-content
          expected_result:
            status_code: 200
            text_marker: "Contenido disponible"

# Notas:
# - La navegación declarativa se ejecuta después del login autenticado.
# - GET utiliza navegación del navegador; POST utiliza una petición HTTP que
#   comparte cookies, pero no carga la página POST en la pestaña.
# - Un HTTP 200 no asegura funcionamiento funcional: use text_marker o url_path
#   cuando haya señales estables y verificadas.
# - Solo se admiten GET y POST; no hay acciones click, popup ni ejecución de JS.
# - No incluir cookies, tokens, secretos o datos personales en los YAML de ejemplo.
# - La documentación complementaria está en docs/declarative-navigation.md.
